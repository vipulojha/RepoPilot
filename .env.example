# Keep secrets and machine-specific configuration out of version control.
# Copy this file to .env locally and provide values only in your environment.

# Backend
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./repopilot.db
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend local API target
VITE_API_BASE_URL=/api/v1
